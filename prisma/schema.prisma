generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  role          String     @default("USER")
  passwordHash  String?
  memberId      String?
  member        Member?    @relation(fields: [memberId], references: [id])
  portalTier    Int?
  jobTitle      String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id])
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// HubSpot Reporting System Models

model Member {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  hubspotCompanyId  String   @unique
  practiceType          String?
  consultantName        String?
  digitalStrategistName String?
  region                    String?
  annualCaseStartsTarget    String?
  websiteUrl                String?
  logoUrl           String?
  allClientsAccountId       String?
  allClientsApiKey          String?
  status            String   @default("active")
  memberSince       DateTime?
  membershipTier    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reports                Report[]
  users                  User[]
  caseStartSubmissions   CaseStartSubmission[]
  prmContactCounts       PrmContactCount[]
  quarterlyFocuses       QuarterlyFocus[]
  deliverables           MemberDeliverable[]
  marketingPlans         MarketingPlan[]
  performanceConfig      MemberPerformanceConfig?
  funnelStageMappings    FunnelStageMapping[]
  performanceReports     PerformanceReport[]
}

model CaseStartSubmission {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  caseStarts Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([memberId, year, month])
}

model PrmContactCount {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  contactCount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([memberId, year, month])
}

model QuarterlyFocus {
  id        String   @id @default(cuid())
  memberId  String
  year      Int
  quarter   Int      // 1–4
  focus     String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, year, quarter])
}

model Report {
  id              String           @id @default(cuid())
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id])
  reportMonth     DateTime
  generatedAt     DateTime         @default(now())
  status          String           @default("draft")
  pdfUrl          String?
  summary         String?
  emailCount      Int              @default(0)
  meetingCount    Int              @default(0)
  activities      ReportActivity[]
  reviewedBy      String?
  reviewedAt      DateTime?
  sentAt          DateTime?
}

model MemberDeliverable {
  id               String                  @id @default(cuid())
  memberId         String
  member           Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year             Int
  category         String
  name             String
  annualAllocation Int
  plannedMonth     Int?
  plannedMonths    Int[]    @default([])
  completions      DeliverableCompletion[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([memberId, year, name])
}

model DeliverableCompletion {
  id                  String            @id @default(cuid())
  memberDeliverableId String
  memberDeliverable   MemberDeliverable @relation(fields: [memberDeliverableId], references: [id], onDelete: Cascade)
  completedAt         DateTime
  notes               String?
  createdAt           DateTime          @default(now())
}

model ReportActivity {
  id              String   @id @default(cuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  activityType    String
  hubspotId       String
  date            DateTime
  subject         String
  rawContent      String?
  summary         String?
  participants    String?
  metadata        Json?
}

// Marketing Plan Models

model MarketingPlan {
  id        String             @id @default(cuid())
  memberId  String
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year      Int
  channels  MarketingChannel[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([memberId, year])
}

model MarketingChannel {
  id              String              @id @default(cuid())
  marketingPlanId String
  marketingPlan   MarketingPlan       @relation(fields: [marketingPlanId], references: [id], onDelete: Cascade)
  name            String
  alwaysOn        Boolean             @default(false)
  description     String?
  sortOrder       Int                 @default(0)
  activities      MarketingActivity[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([marketingPlanId, name])
}

model MarketingActivity {
  id                 String           @id @default(cuid())
  marketingChannelId String
  marketingChannel   MarketingChannel @relation(fields: [marketingChannelId], references: [id], onDelete: Cascade)
  month              Int
  label              String
  ownership          String           @default("TIO")
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([marketingChannelId, month])
}

// Performance Report Models

model MemberPerformanceConfig {
  id                String   @id @default(cuid())
  memberId          String   @unique
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  averageOrderValue Float?
  tcTrackerSheetId  String?
  funnelMappingDone Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FunnelStageMapping {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  prmCategoryId   String
  prmCategoryName String
  funnelStage     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, prmCategoryId])
}

model PerformanceReport {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  status          String   @default("draft")
  funnelData      Json?
  roiData         Json?
  conversionRates Json?
  averageOrderValue Float?
  summary         String?
  generatedAt     DateTime @default(now())
  pdfUrl          String?

  @@unique([memberId, year, month])
}

// Course Builder Models

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  difficulty  String?
  status      String   @default("draft")
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
}

model Module {
  id          String   @id @default(cuid())
  courseId     String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
}

model Lesson {
  id          String         @id @default(cuid())
  moduleId    String
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contentBlocks ContentBlock[]
}

model ContentBlock {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      String
  content   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
